# ── App ──────────────────────────────────────────────────────────────
APP_NAME=RAGnostic
ENVIRONMENT=local
PORT=8000
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
STORAGE_DIR=storage

# ── Supabase (Postgres truth) ──────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# Pooled: postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Tests use DATABASE_URL=memory://tests for an offline DB.

# ── ChromaDB (vector index, local PersistentClient) ────────────────────
# Resolved to <repo-root>/.chromadb (rebuildable from PG chunks); tests use
# server/storage_test/.chromadb; Docker uses /app/.chromadb.
CHROMA_PATH=.chromadb
CHROMA_COLLECTION=ragnostic
# Legacy/unused: CHROMA_URL= (remote mode is not implemented; local PersistentClient is always used)

# ── Auth (JWT custom, HS256) ───────────────────────────────────────────
# Strict boot: missing/placeholder JWT_SECRET raises in production; in
# non-production an ephemeral secret is generated (tokens die on restart).
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false

# ── LLM (NVIDIA NIM, OpenAI-compatible, structured output) ─────────────
# Strict boot: LLM_API_KEY must be set unless MOCK_LLM=true.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TIMEOUT_SECONDS=12
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.95
LLM_MAX_TOKENS=2048
MOCK_LLM=false

# ── Embeddings ─────────────────────────────────────────────────────────
# Strict boot: the model must load unless DISABLE_LOCAL_MODELS=true (offline
# unit tests only, which fall back to deterministic hash embeddings).
# Changing model/dim invalidates the existing .chromadb index — reset it.
EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-s
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=8
DISABLE_LOCAL_MODELS=false

# ── Chunking / Retrieval (deterministic threshold policy) ───────────────
# Confidence = top Chroma cosine score; >= HIGH → 0-hop, else 1-hop → re-score
# → still < HIGH → 2-hop (MAX_HOPS=2). LOW_THRESHOLD is currently reserved.
# CHUNK_SIZE/CHUNK_OVERLAP are aliases of CHUNK_MAX_TOKENS/CHUNK_OVERLAP_TOKENS;
# TOP_K is an alias of RETRIEVAL_TOP_K (kept in sync at startup).
CHUNK_SIZE=400
CHUNK_OVERLAP=50
CHUNK_MIN_TOKENS=320
MAX_CONTEXT_TOKENS=3500
TOP_K=6
HIGH_THRESHOLD=0.75
LOW_THRESHOLD=0.60
MAX_HOPS=2
MAX_GRAPH_NODES=40

# ── Storage / Ops ──────────────────────────────────────────────────────
UPLOAD_MAX_MB=25
RATE_LIMIT_PER_MINUTE=90
DEBUG_RETRIEVAL=false

# ── Frontend (set in client/.env.local) ────────────────────────────────
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
