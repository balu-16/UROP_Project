# Copy to .env.local for local dev and point at the backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production (set in the Vercel dashboard → Project → Settings →
# Environment Variables, NOT in a committed file — NEXT_PUBLIC_* bakes in
# at build time, so redeploy after changing it):
# NEXT_PUBLIC_API_BASE_URL=https://ragnostic-api.duckdns.org
