# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/node_modules
/frontend/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.pnpm-store

# testing
/coverage
/.nyc_output

# next.js
/.next/
/out/

# ensure app sources are not ignored by any broad patterns
!frontend/src/
!frontend/public/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for sharing)
.env
.env.*
!.env.example
!.env.sample
!.env.template
.env*.local
backend/.env
frontend/.env.local

# python/backend
__pycache__/
*.py[cod]
.pytest_cache/
backend/.venv/
/.venv/
/venv/
/env/
.tox/
.nox/
.coverage
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pytype/
backend/storage/
backend/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.eslintcache
